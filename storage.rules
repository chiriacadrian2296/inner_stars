rules_version = '2';

// Each signed-in user can read, list and delete only their own media, under
// users/{uid}/media/<folder>/<file>. Uploads are limited to 5 MB, to pictures
// and audio, and to the three folders the app uses. Everything else is denied.
//
// Reading covers listing too (deleting the account lists the folders to empty
// them); a rule on `<folder>/<file>` alone does not allow listing `media`.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/media/{path=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/media/{folder}/{file} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && folder in ['photos', 'voices', 'moodboard']
        && request.resource.size <= 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('audio/.*'));
    }
  }
}
