---
import Base from '../layouts/Base.astro';
import Galaxy from './JourneyGalaxy';
import SiteHeader from './SiteHeader.astro';
import { pagePath } from '../i18n/routes';
import type { JourneyCopy } from '../i18n/journey';
import { legal, legalPath } from '../i18n/legal';
import '../styles/journey.css';

interface Props { copy: JourneyCopy }
const { copy: c } = Astro.props;
const base = import.meta.env.BASE_URL;
const apk = 'https://github.com/chiriacadrian2296/inner_stars/releases/latest/download/inner-stars.apk';
const web = 'https://my.innerstars.app/';
const ui=c.ui;
const esc = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// [[double brackets]] mark the part of a headline that goes gold
const gold = (text: string) => esc(text).replace(/\[\[(.+?)\]\]/g, '<em>$1</em>');
---
<Base copy={c} faqSchema={false}>
  <a class="skip-link" href="#journey">{c.nav.skip}</a>
  <SiteHeader copy={c}/>
  <main id="journey" tabindex="-1">
    <div class="journey-stage" id="sky-journey">
      <div class="sky-sticky"><Galaxy lang={c.lang} client:load /></div>
      <section class="chapter chapter-hero" id="hero" aria-labelledby="hero-title">
        <div class="chapter-copy">
          <h1 id="hero-title">{c.hero.before}<br /><em>{c.hero.accent}</em><br />{c.hero.after}</h1>
          <p class="chapter-text">{c.hero.text}</p>
        </div>
        <nav class="chapter-nav" aria-label={ui.mainNav}><a class="nav-down" href="#day">{c.hero.scroll}<span aria-hidden="true">↓</span></a></nav>
      </section>
      <section class="chapter chapter-day" id="day" aria-labelledby="day-title"><div class="chapter-copy"><p class="overline"><span class="tiny-star" aria-hidden="true">✦</span> 01 / {ui.overline.day}</p><h2 id="day-title">{c.day.before} <em>{c.day.accent}</em> {c.day.after}</h2><p class="chapter-text">{c.day.text}</p></div><nav class="chapter-nav" aria-label={ui.mainNav}><a class="nav-up" href="#hero" aria-label={ui.prev}><span aria-hidden="true">↑</span></a><a class="nav-down" href="#star">{ui.next.day}<span aria-hidden="true">↓</span></a></nav>
      </section>
      <section class="chapter chapter-star" id="star" aria-labelledby="star-title"><div class="chapter-copy"><p class="overline"><span class="tiny-star" aria-hidden="true">✦</span> 02 / {ui.overline.star}</p><h2 id="star-title">{c.star.before} <em>{c.star.accent}</em></h2><p class="chapter-text">{c.star.text}</p></div><nav class="chapter-nav" aria-label={ui.mainNav}><a class="nav-up" href="#day" aria-label={ui.prev}><span aria-hidden="true">↑</span></a><a class="nav-down" href="#distant">{ui.next.star}<span aria-hidden="true">↓</span></a></nav>
      </section>
      <section class="chapter chapter-distant" id="distant" aria-labelledby="distant-title">
        <div class="chapter-copy">
          <p class="overline"><span class="tiny-star" aria-hidden="true">✦</span> 03 / {ui.overline.distant}</p>
          <h2 id="distant-title">{c.distant.before} <em>{c.distant.accent}</em></h2>
          <p class="chapter-text">{c.distant.text}</p>
        </div>
      <nav class="chapter-nav" aria-label={ui.mainNav}><a class="nav-up" href="#star" aria-label={ui.prev}><span aria-hidden="true">↑</span></a><a class="nav-down" href="#perspective">{ui.next.distant}<span aria-hidden="true">↓</span></a></nav>
      </section>
      <section class="chapter chapter-reveal" id="perspective" aria-labelledby="reveal-title">
        <div class="chapter-copy">
          <p class="overline"><span class="tiny-star" aria-hidden="true">✦</span> 04 / {ui.overline.reveal}</p>
          <h2 id="reveal-title">{c.reveal.before} <em>{c.reveal.accent}</em></h2>
          <p class="chapter-text">{c.reveal.text}</p>
        </div>
      <nav class="chapter-nav" aria-label={ui.mainNav}><a class="nav-up" href="#distant" aria-label={ui.prev}><span aria-hidden="true">↑</span></a><a class="nav-down" href="#whole-sky">{ui.next.reveal}<span aria-hidden="true">↓</span></a></nav>
      </section>
      <section class="chapter chapter-universe" id="whole-sky" aria-labelledby="universe-title">
        <div class="chapter-copy">
          <p class="overline"><span class="tiny-star" aria-hidden="true">✦</span> 05 / {ui.overline.whole}</p>
          <h2 id="universe-title" set:html={gold(ui.wholeTitle)} />
          <p class="chapter-text">{ui.wholeText}</p>
        </div>
      <nav class="chapter-nav" aria-label={ui.mainNav}><a class="nav-up" href="#perspective" aria-label={ui.prev}><span aria-hidden="true">↑</span></a><a class="nav-down" href="#download">{ui.next.whole}<span aria-hidden="true">↓</span></a></nav>
      </section>
    </div>
    <section class="journey-closing" id="download" aria-labelledby="closing-title">
      <nav class="chapter-nav" aria-label={ui.mainNav}><a class="nav-up" href="#whole-sky" aria-label={ui.prev}><span aria-hidden="true">↑</span></a></nav>
      <div class="closing-copy"><p class="overline">{c.closing.eyebrow}</p><h2 id="closing-title" set:html={gold(c.closing.title)} /><p>{c.closing.text}</p><div class="download-actions"><a class="button-gold" href={apk}>{c.closing.apk} <span aria-hidden="true">↓</span></a><a class="button-outline" href={web}>{c.closing.web} <span aria-hidden="true">↗</span></a></div><p class="platform-note">{c.closing.platforms}</p></div>
    </section>
  </main>
  <footer class="journey-footer"><a class="brand" href={pagePath(base,c.lang)}><img src={`${base}logo-mark.svg`} width="24" height="30" alt=""/><span>Inner <em>Stars</em></span></a><span>{c.footer}</span><span class="legal-links"><a href={legalPath(base,c.lang,"privacy")}>{legal[c.lang].privacyLink}</a> · <a href={legalPath(base,c.lang,"terms")}>{legal[c.lang].termsLink}</a></span><a href="https://github.com/chiriacadrian2296/inner_stars">GitHub <span aria-hidden="true">↗</span></a></footer>
</Base>
<script>
  // Chapter-by-chapter scrolling through the whole home: journey, closing and footer.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const root = document.documentElement;
  const sync = () => root.classList.toggle('journey-snap', !reduce.matches);
  sync();
  reduce.addEventListener('change', sync);

  // One eased, cinematic glide shared by the chapter buttons and the mouse wheel. Snapping is
  // paused while it runs and settles exactly on the chapter afterwards.
  let glide = 0; // odd while a glide runs; a newer one (or a touch / key) cancels the older
  const gliding = () => glide % 2 === 1;
  const stopGlide = () => { glide += 1; root.style.scrollBehavior = ''; sync(); };
  const ease = (t: number) => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  const glideTo = (to: number) => {
    const from = scrollY;
    if (reduce.matches || Math.abs(from - to) < 1) { scrollTo(0, to); return; }
    const duration = Math.min(1500, 700 + Math.abs(to - from) * 0.5), start = performance.now();
    glide += gliding() ? 2 : 1;
    const token = glide;
    root.classList.remove('journey-snap'); root.style.scrollBehavior = 'auto';
    const step = (now: number) => {
      if (glide !== token) return;
      const t = Math.min(1, (now - start) / duration);
      scrollTo(0, from + (to - from) * ease(t));
      if (t < 1) requestAnimationFrame(step); else { glide += 1; root.style.scrollBehavior = ''; sync(); }
    };
    requestAnimationFrame(step);
  };
  for (const type of ['touchstart', 'keydown']) addEventListener(type, () => { if (gliding()) stopGlide(); }, { passive: true });
  document.querySelectorAll<HTMLAnchorElement>('.chapter-nav a').forEach(link => link.addEventListener('click', event => {
    const target = document.querySelector(link.getAttribute('href') ?? '');
    if (!target) return;
    event.preventDefault();
    glideTo(Math.round(target.getBoundingClientRect().top + scrollY));
  }));

  // The mouse wheel moves one chapter per gesture with the same glide. A gesture ends after a quiet
  // moment, so a trackpad's trailing momentum cannot start a second glide.
  const stops = () => {
    const tops = [...document.querySelectorAll<HTMLElement>('.chapter, .journey-closing')].map(el => Math.round(el.getBoundingClientRect().top + scrollY));
    return [...tops, Math.max(0, root.scrollHeight - innerHeight)].filter((top, i, all) => i === 0 || top > all[i - 1] + 1);
  };
  let lastWheel = 0;
  addEventListener('wheel', event => {
    if (event.ctrlKey || reduce.matches || Math.abs(event.deltaY) < Math.abs(event.deltaX)) return;
    event.preventDefault();
    const now = performance.now(), quiet = now - lastWheel > 140;
    lastWheel = now;
    if (!quiet || gliding() || Math.abs(event.deltaY) < 2) return;
    const points = stops(), here = points.reduce((best, top, i) => Math.abs(top - scrollY) < Math.abs(points[best] - scrollY) ? i : best, 0);
    const next = Math.max(0, Math.min(points.length - 1, here + (event.deltaY > 0 ? 1 : -1)));
    if (next !== here) glideTo(points[next]);
  }, { passive: false });

</script>
