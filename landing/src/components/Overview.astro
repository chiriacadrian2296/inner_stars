---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import { showGalaxySkyComparison } from '../features';
import { GalaxyExplorer } from './JourneyGalaxy';
import { topicSlugs, topicTitles, pagePath, type Topic } from '../i18n/routes';
import type { JourneyCopy } from '../i18n/journey';
import type { Lang } from '../i18n/types';
import '../styles/journey.css';

interface Props { copy: JourneyCopy }
const { copy: c } = Astro.props;
const base = import.meta.env.BASE_URL;
const it=c.lang==='it';
const guideLang:Lang=c.lang==='ro'?'en':c.lang;
const current=import.meta.glob<{default:ImageMetadata}>('../assets/current/*.png',{eager:true});
const shot=(name:string)=>current[`../assets/current/${c.lang}-${name}.png`].default;
const { getImage }=await import('astro:assets');
const comparisonShots=showGalaxySkyComparison ? await Promise.all(['areas','projects','activities'].map(async name=>(await getImage({src:shot(name),width:430,format:'webp'})).src)) : [];
const shots=[shot('reader'),shot('constellation'),shot('activities')];
const copy={...c,title:it?'L’app — Inner Stars':'The app — Inner Stars',description:c.product.text};
---
<Base copy={copy} topic="overview">
  <a class="skip-link" href="#app">{c.nav.skip}</a>
  <SiteHeader copy={c} topic="overview"/>
  <main id="overview" tabindex="-1" class="overview-main">
    <section class="product-section" id="app" aria-labelledby="product-title">
      <div class="product-intro">
        <p class="overline">{c.product.eyebrow}</p>
        <h2 id="product-title">{c.product.title}</h2>
        <p>{c.product.text}</p>
      </div>
      {showGalaxySkyComparison && <GalaxyExplorer lang={c.lang} shots={comparisonShots} client:visible/>}
      <div class="product-stories">
        {c.product.items.map((item, i) => <article class={`product-story story-${i}`}>
          <div class="product-words"><span class="story-number">0{i + 1}</span><h3>{item.title}</h3><p>{item.text}</p><a class="text-link" href={`${base}${topicSlugs[guideLang][(['levels','customization','navigation'] as Topic[])[i]]}`}>{it?['Come si organizza il tuo cielo','Crea la tua costellazione','Come ritrovare un ricordo'][i]:['How your sky is organized','Create your constellation','How to find a memory'][i]} <span aria-hidden="true">↗</span></a></div>
          <figure class="product-figure"><div class="phone-aura"></div><div class="journey-phone"><div class="phone-speaker" aria-hidden="true"></div><Image src={shots[i]} alt={item.caption} width={390} format="webp" quality={85} loading="lazy" /></div><figcaption>{item.caption}</figcaption></figure>
        </article>)}
      </div>
    </section>
    <section class="feature-guides" aria-labelledby="guides-title"><p class="overline">{it?'ENTRA NELL’APP':'GET TO KNOW THE APP'}</p><h2 id="guides-title">{it?'Un po’ più da vicino.':'A closer look.'}</h2><div class="guide-links">{(['levels','navigation','customization'] as Topic[]).map((topic,i)=><a href={`${base}${topicSlugs[guideLang][topic]}`}><span class="story-number">0{i+1}</span><h3>{topicTitles[guideLang][topic]}</h3><span aria-hidden="true">↗</span></a>)}</div></section>
    <section class="journey-faq" aria-labelledby="faq-title">
      <div><p class="overline">INNER STARS / FAQ</p><h2 id="faq-title">{c.faq.title}</h2></div>
      <div class="faq-list">{c.faq.items.map(item => <details><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div>
    </section>
  </main>
  <footer class="journey-footer"><a class="brand" href={pagePath(base,c.lang)}><img src={`${base}logo-mark.svg`} width="24" height="30" alt=""/><span>Inner <em>Stars</em></span></a><span>{c.footer}</span><a href="https://github.com/chiriacadrian2296/inner_stars">GitHub <span aria-hidden="true">↗</span></a></footer>
</Base>
