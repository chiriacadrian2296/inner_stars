---
import type { SiteLang } from '../i18n/types';
import { pagePath, type Topic } from '../i18n/routes';

interface Props {
  copy: { lang: SiteLang; title: string; description: string; faq: { items: { q: string; a: string }[] } };
  classic?: boolean;
  topic?: Topic | 'overview';
  faqSchema?: boolean;
}
const { copy, classic = false, topic, faqSchema = true } = Astro.props;

const base = import.meta.env.BASE_URL; // '/inner_stars/'
const site = Astro.site!.origin;
const localeBase = `${base}${classic ? 'classic/' : ''}`;
const path = classic ? (copy.lang === 'it' ? localeBase : `${localeBase}en/`) : pagePath(base,copy.lang,topic);
const canonical = site + path;
const urlIt = site + (classic ? localeBase : pagePath(base,'it',topic));
const urlEn = site + (classic ? `${localeBase}en/` : pagePath(base,'en',topic));
const urlRo = site + pagePath(base, 'ro', topic);
const hasRo = !classic && !topic;
const ogImage = `${site}${base}og-image.png`;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Inner Stars',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Android, Web',
  description: copy.description,
  inLanguage: copy.lang,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
---
<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    {classic && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0d1220" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={urlIt} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    {hasRo && <link rel="alternate" hreflang="ro" href={urlRo} />}
    <link rel="alternate" hreflang="x-default" href={urlIt} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg?v=gold2-20261018`} />
    <link rel="icon" type="image/png" href={`${base}favicon.png?v=gold2-20261018`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png?v=gold2-20261018`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={copy.lang === 'it' ? 'it_IT' : copy.lang === 'ro' ? 'ro_RO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={`${base}fonts/${classic ? 'Gloock-Regular.ttf' : 'Newsreader-Variable.ttf'}`} as="font" type="font/ttf" crossorigin />
    <link rel="preload" href={`${base}fonts/InstrumentSans-Variable.ttf`} as="font" type="font/ttf" crossorigin />
    <style
      set:html={`
      @font-face{font-family:'Gloock';src:url('${base}fonts/Gloock-Regular.ttf');font-display:swap}
      @font-face{font-family:'Instrument Sans';src:url('${base}fonts/InstrumentSans-Variable.ttf');font-weight:400 700;font-display:swap}
      @font-face{font-family:'Newsreader';src:url('${base}fonts/Newsreader-Variable.ttf');font-weight:200 800;font-display:swap}
      @font-face{font-family:'Newsreader';font-style:italic;src:url('${base}fonts/Newsreader-Italic.ttf');font-weight:200 800;font-display:swap}
    `}
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
