{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "share-lab-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "8791",
        "-t",
        "tool/share_lab_preview.dart"
      ],
      "port": 8791
    },
    {
      "name": "app-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "web-server", "--web-port", "5000"],
      "port": 5000
    },
    {
      "name": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "landing", "--", "--host", "127.0.0.1", "--port", "4321"],
      "port": 4321,
      "url": "http://127.0.0.1:4321"
    }
  ]
}

